---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const profile = await import('../data/profile.json');
const projectsData = await import('../data/projects.json');
const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Get all projects from content collection
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => 
  (b.data.year || 0) - (a.data.year || 0)
);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content={`${profile.name} - ${profile.title}`} />
	<title>{profile.name}</title>
</head>
<body>
	<!-- Header -->
	<header>
		<h1>{profile.name}</h1>
		<p class="tagline">{profile.tagline}</p>
	</header>

	<!-- About Section -->
	<section class="section">
		<h2>About</h2>
		<div class="about">
			<div class="about-content">
				{profile.about.map((paragraph) => (
					<p>{paragraph}</p>
				))}
			</div>
			<img src="/cropped_circle_image.png" alt={profile.name} class="profile-photo" />
		</div>
	</section>

	<!-- Skills Section -->
	{profile.showSkills && (
		<section class="section">
			<h2>Skills</h2>
			<div class="skills-grid">
				{Object.entries(profile.skills).map(([category, items]) => (
					<div class="skill-category">
						<h3>{category.charAt(0).toUpperCase() + category.slice(1)}</h3>
						<p>{items.join(', ')}</p>
					</div>
				))}
			</div>
		</section>
	)}

	<!-- Projects -->
	<section class="section">
		<h2>Projects</h2>
		<ul>
			{sortedProjects.slice(0, 6).map((project) => (
				<li class="project-item">
					<div class="project-title">
						<a href={`/projects/${project.slug}`}>{project.data.title}</a>
					</div>
					<p class="project-description">{project.data.description}</p>
				</li>
			))}
		</ul>
		<p style="margin-top: 1.5rem;">
			<a href="/projects">View all projects →</a>
		</p>
	</section>

	<!-- Blog Posts -->
	<section class="section">
		<h2>Writing</h2>
		<ul>
			{sortedPosts.map((post) => (
				<li class="post-item">
					<span class="post-date">{post.data.date}</span>
					<a href={`/blog/${post.slug}`}>{post.data.title}</a>
				</li>
			))}
		</ul>
	</section>

	<!-- Contact -->
	<section class="contact">
		<h2>Contact</h2>
		<div class="social-links">
			<a href={`mailto:${profile.email}`}>Email</a>
			<a href={profile.github} target="_blank" rel="noopener">GitHub</a>
			{profile.twitter && <a href={profile.twitter} target="_blank" rel="noopener">Twitter</a>}
			<a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
			{profile.blog && <a href={profile.blog} target="_blank" rel="noopener">Blog</a>}
		</div>
	</section>
</body>
</html>
