---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { getHashnodeBlogs } from '../lib/hashnode';
import { getCurrentTheme } from '../lib/theme';
import SnowEffect from '../components/SnowEffect.astro';
import RainEffect from '../components/RainEffect.astro';
import LeafEffect from '../components/LeafEffect.astro';
import FestiveDecoration from '../components/FestiveDecoration.astro';
import SeasonDecoration from '../components/SeasonDecoration.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const profile = await import('../data/profile.json');
const { festival: currentFestival, season: currentSeason, enableSnow, enableRain, enableLeaves } = getCurrentTheme();

// Fetch blogs from Hashnode
const hashnodeBlogs = await getHashnodeBlogs(5);

// Get all projects from content collection
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => 
  (b.data.year || 0) - (a.data.year || 0)
);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/png" href="/fevicon.png" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content={`${profile.name} - ${profile.title}`} />
	<title>{profile.name}</title>
	<script defer src="https://cloud.umami.is/script.js" data-website-id="698c1618-48cf-423b-82af-eee68731e9c7"></script>
</head>
<body>
	<SeasonDecoration season={currentSeason} />
	{enableSnow && <SnowEffect />}
	{enableRain && <RainEffect />}
	{enableLeaves && <LeafEffect season={currentSeason} />}
	<ThemeToggle />
	<!-- Header -->
	<header>
		<div class="header-content">
			<h1>{profile.name}<FestiveDecoration festival={currentFestival} /></h1>
			<nav class="nav">
				<a href="/" class="active">Home</a>
				<a href="/projects">Projects</a>
				<a href="/blog">Blog</a>
			</nav>
		</div>
		<p class="tagline">{profile.tagline}</p>
	</header>

	<!-- About Section -->
	<section class="section">
		<h2>About</h2>
		<div class="about">
			<div class="about-content">
				{profile.about.map((paragraph) => (
					<p>{paragraph}</p>
				))}
			</div>
			<img src="/cropped_circle_image.png" alt={profile.name} class="profile-photo" />
		</div>
	</section>

	<!-- Skills Section -->
	{profile.showSkills && (
		<section class="section">
			<h2>Skills</h2>
			<div class="skills-grid">
				{Object.entries(profile.skills).map(([category, items]) => (
					<div class="skill-category">
						<h3>{category.charAt(0).toUpperCase() + category.slice(1)}</h3>
						<p>{items.join(', ')}</p>
					</div>
				))}
			</div>
		</section>
	)}

	<!-- Projects -->
	<section class="section">
		<h2>Projects</h2>
		<ul>
			{sortedProjects.slice(0, 3).map((project) => (
				<li class="project-item">
					<div class="project-title">
						<a href={`/projects/${project.slug}`}>{project.data.title}</a>
					</div>
					<p class="project-description">{project.data.description}</p>
				</li>
			))}
		</ul>
		<p style="margin-top: 1.5rem;">
			<a href="/projects">View all projects →</a>
		</p>
	</section>

	<!-- Blog Posts -->
	<section class="section">
		<h2>Writing</h2>
		<ul>
			{hashnodeBlogs.map((post) => (
				<li class="post-item">
					<span class="post-date">{new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
					<a href={post.url} target="_blank" rel="noopener noreferrer">{post.title}</a>
				</li>
			))}
		</ul>
		<p style="margin-top: 1.5rem;">
			<a href="/blog">View all posts →</a>
		</p>
	</section>

	<!-- Contact -->
	<section class="contact">
		<h2>Contact</h2>
		<div class="social-links">
			<a href={`mailto:${profile.email}`}>Email</a>
			<a href={profile.github} target="_blank" rel="noopener">GitHub</a>
			{profile.twitter && <a href={profile.twitter} target="_blank" rel="noopener">Twitter</a>}
			<a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
			{profile.blog && <a href={profile.blog} target="_blank" rel="noopener">Blog</a>}
			{profile.cv && <a href={profile.cv} target="_blank" rel="noopener">Download CV</a>}
		</div>
	</section>
</body>
</html>
