---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const profile = await import('../data/profile.json');
const allProjects = await getCollection('projects');

// Sort by year (newest first)
const sortedProjects = allProjects.sort((a, b) => 
  (b.data.year || 0) - (a.data.year || 0)
);

// Group by category
const personalProjects = sortedProjects.filter(p => p.data.category === 'personal');
const companyProjects = sortedProjects.filter(p => p.data.category === 'company');
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content={`Projects by ${profile.name}`} />
	<title>Projects - {profile.name}</title>
</head>
<body>
	<header>
		<a href="/">← Back to home</a>
		<h1 style="margin-top: 2rem;">Projects</h1>
	</header>

	{personalProjects.length > 0 && (
		<section class="section">
			<h2>Personal Projects</h2>
			<ul>
				{personalProjects.map((project) => (
					<li class="project-item">
						<div class="project-title">
							<a href={`/projects/${project.slug}`}>{project.data.title}</a>
						</div>
						<p class="project-description">{project.data.description}</p>
						{project.data.tags && project.data.tags.length > 0 && (
							<div style="margin-top: 0.5rem;">
								{project.data.tags.map((tag: string) => (
									<span style="display: inline-block; background: #f0f0f0; padding: 0.2rem 0.6rem; margin-right: 0.5rem; font-size: 0.85rem; border-radius: 3px;">
										{tag}
									</span>
								))}
							</div>
						)}
					</li>
				))}
			</ul>
		</section>
	)}

	{companyProjects.length > 0 && (
		<section class="section">
			<h2>Company / Professional Projects</h2>
			<ul>
				{companyProjects.map((project) => (
					<li class="project-item">
						<div class="project-title">
							<a href={`/projects/${project.slug}`}>{project.data.title}</a>
						</div>
						<p class="project-description">{project.data.description}</p>
						{project.data.tags && project.data.tags.length > 0 && (
							<div style="margin-top: 0.5rem;">
								{project.data.tags.map((tag: string) => (
									<span style="display: inline-block; background: #f0f0f0; padding: 0.2rem 0.6rem; margin-right: 0.5rem; font-size: 0.85rem; border-radius: 3px;">
										{tag}
									</span>
								))}
							</div>
						)}
					</li>
				))}
			</ul>
		</section>
	)}
</body>
</html>
