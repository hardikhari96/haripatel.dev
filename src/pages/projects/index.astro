---
import '../../styles/global.css';
import { getCollection } from 'astro:content';

const profile = await import('../../data/profile.json');
const allProjects = await getCollection('projects');

// Sort by year (newest first)
const sortedProjects = allProjects.sort((a, b) => 
  (b.data.year || 0) - (a.data.year || 0)
);

// Group by category
const personalProjects = sortedProjects.filter(p => p.data.category === 'personal');
const companyProjects = sortedProjects.filter(p => p.data.category === 'company');

console.log('All projects:', allProjects.length);
console.log('Personal projects:', personalProjects.length);
console.log('Company projects:', companyProjects.length);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/png" href="/fevicon.png" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content={`Projects by ${profile.name}`} />
	<title>Projects - {profile.name}</title>
	<style>
		.header-content {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0.5rem;
			flex-wrap: wrap;
			gap: 1rem;
		}

		.nav {
			display: flex;
			gap: 1.5rem;
		}

		.nav a {
			color: #666;
			text-decoration: none;
			font-size: 0.95rem;
			transition: color 0.2s;
		}

		.nav a:hover,
		.nav a.active {
			color: #0066cc;
		}

		.filter-buttons {
			display: flex;
			gap: 1rem;
			margin-bottom: 2rem;
			flex-wrap: wrap;
		}
		.filter-btn {
			padding: 0.5rem 1rem;
			background: #fff;
			border: 1px solid #000;
			color: #000;
			cursor: pointer;
			font-size: 0.95rem;
			font-family: inherit;
			transition: all 0.2s;
		}
		.filter-btn:hover {
			background: #000;
			color: #fff;
		}
		.filter-btn.active {
			background: #000;
			color: #fff;
		}

		@media (max-width: 768px) {
			.header-content {
				gap: 0.5rem;
			}

			.nav {
				gap: 1rem;
			}
		}
	</style>
</head>
<body>
	<header>
		<div class="header-content">
			<h1>Harikrushna Patel</h1>
			<nav class="nav">
				<a href="/">Home</a>
				<a href="/projects" class="active">Projects</a>
				<a href="/blog">Blog</a>
			</nav>
		</div>
		<p class="tagline">Personal and professional work</p>
	</header>

	<!-- Filter Buttons -->
	<section class="section">
		<div class="filter-buttons">
			<button class="filter-btn active" data-filter="all">All ({sortedProjects.length})</button>
			<button class="filter-btn" data-filter="personal">Personal ({personalProjects.length})</button>
			<button class="filter-btn" data-filter="company">Company ({companyProjects.length})</button>
		</div>
	</section>

	<!-- All Projects -->
	<section class="section">
		<ul id="projects-list">
			{sortedProjects.map((project) => (
				<li class="project-item" data-category={project.data.category || 'none'}>
					<div class="project-title">
						<a href={`/projects/${project.slug}`}>{project.data.title}</a>
					</div>
					<p class="project-description">{project.data.description}</p>
					{project.data.tags && project.data.tags.length > 0 && (
						<div style="margin-top: 0.5rem;">
							{project.data.tags.map((tag: string) => (
								<span style="display: inline-block; background: #f0f0f0; padding: 0.2rem 0.6rem; margin-right: 0.5rem; font-size: 0.85rem; border-radius: 3px;">
									{tag}
								</span>
							))}
						</div>
					)}
				</li>
			))}
		</ul>
	</section>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
			const projectItems = document.querySelectorAll<HTMLElement>('.project-item');

			filterButtons.forEach(button => {
				button.addEventListener('click', () => {
					const filter = button.dataset.filter;

					// Update active button
					filterButtons.forEach(btn => btn.classList.remove('active'));
					button.classList.add('active');

					// Filter projects
					projectItems.forEach(item => {
						const category = item.dataset.category;
						if (filter === 'all' || category === filter) {
							item.style.display = 'block';
						} else {
							item.style.display = 'none';
						}
					});
				});
			});
		});
	</script>
</body>
</html>
