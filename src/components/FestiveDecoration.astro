---
// Festive Decoration Component - Switchable for different festivals
type FestivalType = 'christmas' | 'newyear' | 'valentines' | 'holi' | 'easter' | 'eid' | 
  'independenceday' | 'ganeshchaturthi' | 'halloween' | 'diwali' | 'thanksgiving' | 'none';

interface Props {
  festival?: string;
}

const { festival = 'none' } = Astro.props;
const festivalKey = festival as FestivalType;

// Load festival data
const themeData = await import('../data/theme.json');
const decoration = themeData.festivals[festivalKey]?.emoji || '';
---

{decoration && (
  <span class="festive-decoration" data-festival={festival}>
    {decoration}
  </span>
)}

<style>
  .festive-decoration {
    display: inline-block;
    margin-left: 0.3rem;
    font-size: 1.2em;
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    25% {
      transform: translateY(-5px) rotate(-10deg);
    }
    75% {
      transform: translateY(-3px) rotate(10deg);
    }
  }

  .festive-decoration[data-festival="christmas"] {
    animation: santa-wiggle 1.5s ease-in-out infinite;
  }

  @keyframes santa-wiggle {
    0%, 100% {
      transform: rotate(-5deg);
    }
    50% {
      transform: rotate(5deg);
    }
  }

  .festive-decoration[data-festival="valentines"] {
    animation: heart-beat 1s ease-in-out infinite;
  }

  @keyframes heart-beat {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
  }

  .festive-decoration[data-festival="holi"] {
    animation: color-splash 3s linear infinite;
  }

  @keyframes color-splash {
    0%, 100% {
      filter: hue-rotate(0deg);
    }
    50% {
      filter: hue-rotate(360deg);
    }
  }

  .festive-decoration[data-festival="easter"] {
    animation: bunny-hop 1s ease-in-out infinite;
  }

  @keyframes bunny-hop {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .festive-decoration[data-festival="eid"] {
    animation: moon-glow 2s ease-in-out infinite;
  }

  @keyframes moon-glow {
    0%, 100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.5);
    }
  }

  .festive-decoration[data-festival="independenceday"] {
    animation: flag-wave 2s ease-in-out infinite;
  }

  @keyframes flag-wave {
    0%, 100% {
      transform: rotate(-10deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }

  .festive-decoration[data-festival="ganeshchaturthi"] {
    animation: gentle-sway 2s ease-in-out infinite;
  }

  @keyframes gentle-sway {
    0%, 100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }

  .festive-decoration[data-festival="diwali"] {
    animation: diya-glow 2s ease-in-out infinite;
  }

  @keyframes diya-glow {
    0%, 100% {
      filter: brightness(1);
      transform: scale(1);
    }
    50% {
      filter: brightness(1.5);
      transform: scale(1.1);
    }
  }

  .festive-decoration[data-festival="halloween"] {
    animation: spooky-shake 3s ease-in-out infinite;
  }

  @keyframes spooky-shake {
    0%, 100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-15deg);
    }
    75% {
      transform: rotate(15deg);
    }
  }

  .festive-decoration[data-festival="thanksgiving"] {
    animation: turkey-strut 1.5s ease-in-out infinite;
  }

  @keyframes turkey-strut {
    0%, 100% {
      transform: scale(1) rotate(0deg);
    }
    50% {
      transform: scale(1.1) rotate(5deg);
    }
  }

  .festive-decoration[data-festival="newyear"] {
    animation: party-pop 1s ease-in-out infinite;
  }

  @keyframes party-pop {
    0%, 100% {
      transform: scale(1) rotate(0deg);
    }
    50% {
      transform: scale(1.2) rotate(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .festive-decoration {
      animation: none;
    }
  }
</style>
