<!-- Floating chatbot widget -->
<div id="chatbot-toggle" class="chatbot-toggle" title="Chat with AI about Hari's profile">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
  </svg>
</div>

<div id="chatbot-container" class="chatbot-container chatbot-hidden">
  <div class="chatbot-header">
    <span>Ask about Hari</span>
    <button id="chatbot-close" class="chatbot-close" title="Close chat">&times;</button>
  </div>
  <div id="chatbot-messages" class="chatbot-messages">
    <div class="chatbot-message bot-message">
      Hi! I'm an AI assistant. Ask me anything about Harikrushna's skills, experience, or projects!
    </div>
  </div>
  <form id="chatbot-form" class="chatbot-input-area">
    <input
      id="chatbot-input"
      type="text"
      placeholder="Ask about Hari's profile..."
      autocomplete="off"
    />
    <button type="submit" class="chatbot-send" title="Send">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
    </button>
  </form>
</div>

<style>
  .chatbot-toggle {
    position: fixed;
    bottom: 88px;
    right: 24px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #0066cc;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    z-index: 999;
    transition: background 0.2s;
  }
  .chatbot-toggle:hover {
    background: #004999;
  }

  .chatbot-container {
    position: fixed;
    bottom: 152px;
    right: 24px;
    width: 360px;
    max-height: 480px;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    z-index: 999;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  }
  .chatbot-hidden {
    display: none !important;
  }

  .chatbot-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid #e0e0e0;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .chatbot-close {
    background: none;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    color: #666;
    line-height: 1;
  }
  .chatbot-close:hover {
    color: #000;
  }

  .chatbot-messages {
    flex: 1;
    overflow-y: auto;
    padding: 12px 16px;
    min-height: 200px;
    max-height: 320px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .chatbot-message {
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 85%;
    word-wrap: break-word;
  }
  .bot-message {
    background: #f0f0f0;
    color: #333;
    align-self: flex-start;
  }
  .user-message {
    background: #0066cc;
    color: #fff;
    align-self: flex-end;
  }

  .chatbot-input-area {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid #e0e0e0;
  }
  .chatbot-input-area input {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 0.9rem;
    outline: none;
  }
  .chatbot-input-area input:focus {
    border-color: #0066cc;
  }
  .chatbot-send {
    background: #0066cc;
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 8px 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .chatbot-send:hover {
    background: #004999;
  }
  .chatbot-send:disabled {
    background: #999;
    cursor: not-allowed;
  }

  /* Dark theme support */
  :global([data-theme="dark"]) .chatbot-container {
    background: #1a1a2e;
    border-color: #333;
  }
  :global([data-theme="dark"]) .chatbot-header {
    border-color: #333;
    color: #e0e0e0;
  }
  :global([data-theme="dark"]) .chatbot-close {
    color: #aaa;
  }
  :global([data-theme="dark"]) .bot-message {
    background: #2a2a3e;
    color: #e0e0e0;
  }
  :global([data-theme="dark"]) .chatbot-input-area {
    border-color: #333;
  }
  :global([data-theme="dark"]) .chatbot-input-area input {
    background: #2a2a3e;
    color: #e0e0e0;
    border-color: #444;
  }

  @media (max-width: 480px) {
    .chatbot-container {
      width: calc(100vw - 32px);
      right: 16px;
      bottom: 144px;
    }
    .chatbot-toggle {
      right: 16px;
      bottom: 80px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('chatbot-toggle')!;
  const container = document.getElementById('chatbot-container')!;
  const closeBtn = document.getElementById('chatbot-close')!;
  const form = document.getElementById('chatbot-form') as HTMLFormElement;
  const input = document.getElementById('chatbot-input') as HTMLInputElement;
  const messagesEl = document.getElementById('chatbot-messages')!;

  // Conversation history for context
  const conversationHistory: Array<{ role: string; content: string }> = [];

  toggle.addEventListener('click', () => {
    container.classList.toggle('chatbot-hidden');
    if (!container.classList.contains('chatbot-hidden')) {
      input.focus();
    }
  });

  closeBtn.addEventListener('click', () => {
    container.classList.add('chatbot-hidden');
  });

  function appendMessage(text: string, sender: 'user' | 'bot') {
    const div = document.createElement('div');
    div.className = `chatbot-message ${sender}-message`;
    div.textContent = text;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;

    appendMessage(text, 'user');
    input.value = '';

    conversationHistory.push({ role: 'user', content: text });

    const sendBtn = form.querySelector('.chatbot-send') as HTMLButtonElement;
    sendBtn.disabled = true;
    input.disabled = true;

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: conversationHistory }),
      });

      const data = await res.json();

      if (res.ok && data.reply) {
        appendMessage(data.reply, 'bot');
        conversationHistory.push({ role: 'assistant', content: data.reply });
      } else {
        appendMessage(data.error || 'Something went wrong. Please try again.', 'bot');
      }
    } catch {
      appendMessage('Failed to connect. Please try again later.', 'bot');
    } finally {
      sendBtn.disabled = false;
      input.disabled = false;
      input.focus();
    }
  });
</script>
