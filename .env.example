# OpenRouter API key for the profile chatbot
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the chat model (default: meta-llama/llama-3.3-70b-instruct)
# Must support tool calling. Example free option: nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=
